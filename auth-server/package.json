{
  "name": "keyora-auth",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --watch server.ts",
    "start": "node --env-file-if-exists=../.env server.ts",
    "migrate": "node --env-file-if-exists=../.env ./node_modules/auth/dist/index.mjs migrate --config auth.ts --yes",
    "generate": "node --env-file-if-exists=../.env ./node_modules/auth/dist/index.mjs generate --config auth.ts",
    "seed:users": "node --env-file-if-exists=../.env seed-users.ts"
  },
  "dependencies": {
    "better-auth": "^1.7.25",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "auth": "^1.7.25"
  }
}
