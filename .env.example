# Copy to .env and fill in. .env is git-ignored; this file is not, so never put real secrets here.
#   cp .env.example .env

# --- Flask -------------------------------------------------------------------
# Lets `flask db …` / `flask seed` run without --app.
FLASK_APP=run.py
# Signs sessions/cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# --- Database ----------------------------------------------------------------
# Paste the connection string as-is; app/config.py switches postgres:// and
# postgresql:// to the psycopg 3 driver (postgresql+psycopg://).

# Neon (console → your project → Connect). Use the *direct* string (host without
# "-pooler"): one Flask process with SQLAlchemy's own pool doesn't need PgBouncer,
# and schema migrations should run on a direct connection anyway.
# Keep sslmode=require — Neon only accepts TLS connections.
DATABASE_URL=postgresql://USER:PASSWORD@ep-XXXX-XXXX.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Pooled Neon string (host contains "-pooler"). Only switch DATABASE_URL to this
# when deploying somewhere that opens many short-lived connections (serverless,
# many workers), and keep running migrations with the direct string.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-XXXX-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Local Postgres instead of Neon (Homebrew: createdb keyora). This is also the
# fallback when DATABASE_URL is unset.
# DATABASE_URL=postgresql://localhost/keyora

# --- Better Auth (auth-server/) ------------------------------------------------
# The Node auth service reads this same file (DATABASE_URL included) and shares the
# database. Generate the secret with:  openssl rand -base64 32   (≥ 32 characters)
BETTER_AUTH_SECRET=change-me-to-32-plus-random-characters
# Public origin of the *Flask* site: auth cookies are issued for it, and Flask sends
# it as Origin on its calls to the auth service. Must match the URL you browse.
BETTER_AUTH_URL=http://127.0.0.1:5000
# Where Flask reaches the auth service. It binds to 127.0.0.1 only; never expose it.
AUTH_SERVER_URL=http://127.0.0.1:3005
AUTH_PORT=3005

# --- Bakong KHQR payments ------------------------------------------------------
# Developer token from https://api-bakong.nbc.gov.kh (Register). Server-only secret.
# It expires (~90 days): renew with POST /v1/renew_token {"email": "..."} before then,
# or every payment check fails and orders look unpaid. The API only answers Cambodian IPs.
BAKONG_TOKEN=
# Receiving Bakong account (name@bank). Check it with `flask bakong-check`.
BAKONG_ACCOUNT_ID=shop@bank
# Shown in the customer's banking app. ASCII only.
MERCHANT_NAME=Keyora                  # max 25
MERCHANT_CITY=Phnom Penh              # max 15
MERCHANT_PHONE=                       # optional
STORE_LABEL=                          # optional, max 25
TERMINAL_LABEL=                       # optional, max 25, e.g. Web
# Minutes a checkout QR stays payable (stock is held for the same time).
KHQR_EXPIRATION_MINUTES=15
BAKONG_API_URL=                       # optional; defaults to https://api-bakong.nbc.gov.kh/v1

# --- Cloudinary (admin product photo uploads) ---------------------------------
# Console → Settings → API Keys. The secret is server-only. Leave all three blank to
# hide the upload field (Unsplash photo ids keep working either way).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=keyora/products     # optional

# --- Debugging ---------------------------------------------------------------
# 1 = log every SQL statement.
SQLALCHEMY_ECHO=0
